# /etc/sunset-agent.conf — copy this, fill it in, keep it private (it holds the token).
# Shell syntax: KEY="value", no spaces around "=".

API_BASE="https://www.sunrisesunset.studio"

# From the parent repo's scripts/tier0-create-camera.sh (or /api/cameras/provision).
CAMERA_ID=""
DEVICE_TOKEN=""

# Which camera this is: wyze-v3 | sonoff-cam-s2 | sonoff-cam-b1p.
# The setup app uses it for the camera's field of view and the printed mount.
CAMERA_MODEL="wyze-v3"

# Only for claim-code onboarding (provision endpoint). Leave empty for tier0 cameras.
# HARDWARE_ID must then match what the camera was provisioned with.
CLAIM_CODE=""
HARDWARE_ID=""

# Where the camera is, until the server supplies a location. Decimal degrees.
LAT=""
LNG=""

# Which way it points. Not needed if you finish setup in the phone app
# (/setup/<claim code>): the app sends the aim. For a tier0 camera, type it here.
# Compass bearing, 0=N 90=E 180=S 270=W; tilt in degrees above level.
AZIMUTH_DEG=""
TILT_DEG="0"

# sunrise | sunset | both. A placement set on the server overrides this.
PHASE="sunset"

# Seconds between frames inside a window. The Pi uses 1; Wi-Fi cameras should not.
INTERVAL_S=20

# 1 = wait until the server says placement is ready. 0 = capture as soon as
# LAT/LNG are known (handy for a bench test; tier0 cameras still need AZIMUTH_DEG
# for the server to call them ready).
REQUIRE_PLACEMENT=1

# Minutes of capture around each event.
SUNSET_BEFORE_MIN=45
SUNSET_AFTER_MIN=30
SUNRISE_BEFORE_MIN=30
SUNRISE_AFTER_MIN=45

# Live view for the phone setup wizard: while it's open, send a low-res frame
# every PREVIEW_INTERVAL_S (channel 1 is Thingino's substream). Previews are
# never stored as captures.
#PREVIEW_CMD="prudyntctl snapshot -c 1"
#PREVIEW_INTERVAL_S=3
