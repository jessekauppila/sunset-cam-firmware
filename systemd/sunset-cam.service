[Unit]
Description=Sunset Cam edge-camera firmware
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
# time-sync.target is only reached after NTP sets the clock if
# systemd-time-wait-sync.service is enabled on the image:
#   sudo systemctl enable systemd-time-wait-sync.service
# The firmware also refuses to capture while the clock reads earlier than the
# config file's mtime, as a second guard (a Pi Zero has no RTC).

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/sunset-cam
ExecStart=/opt/sunset-cam/.venv/bin/python -m sunset_cam.main /opt/sunset-cam/config/config.json
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
